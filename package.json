{
  "name": "spell-tracker",
  "version": "0.2.0",
  "private": true,
  "description": "Personal League of Legends enemy summoner spell overlay",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "capture": "npm run build && node dist/capture/capture.js",
    "shortcut": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.pandacall.spell-tracker",
    "productName": "Spell Tracker",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/capture/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spell Tracker",
      "runAfterFinish": true,
      "artifactName": "Spell-Tracker-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "pandacall",
      "repo": "spell-tracker"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3"
  }
}
